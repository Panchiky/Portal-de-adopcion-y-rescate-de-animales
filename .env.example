# Copiar este archivo como .env y completar con los valores locales
PORT=3000
CORS_ORIGIN=http://localhost:8100,http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=patitasgo
DB_USER=postgres
DB_PASSWORD=tu_clave_de_postgres

# Clave larga y aleatoria para firmar los tokens, mínimo 32 caracteres (no compartir)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria
JWT_EXPIRES_IN=2h

# Cantidad de proxies delante de la API (0 en local, 1 si se publica detrás de un proxy)
TRUST_PROXY=0
